@page "/profile"
@layout MainLayout
@using BookStore.Shared.Models
@using BookStore.Shared.Services
@inject StoreApiClient StoreApi
@inject NavigationManager Navigation

<PageTitle>Hồ sơ của tôi | Trang Sách</PageTitle>
<main class="page-shell profile-page">
    <div class="profile-heading"><p class="eyebrow">TÀI KHOẢN CỦA BẠN</p><h1>Hồ sơ cá nhân</h1><p>Thông tin tài khoản và liên hệ của bạn.</p></div>
    @if (!loaded) { <div class="profile-loading">Đang tải hồ sơ…</div> }
    else if (!string.IsNullOrWhiteSpace(error)) { <div class="profile-error">@error</div> }
    else if (profile is not null)
    {
        <ProfileCard Profile="profile" />
        <div class="profile-actions"><a class="button-primary" href="/orders">Đơn hàng của tôi <span>↗</span></a><a class="text-link" href="/books">Tiếp tục mua sách →</a></div>
    }
</main>

@code {
    private StoreProfile? profile;
    private bool loaded;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var role = await StoreApi.GetCurrentRoleAsync();
        if (role == "Manager") { Navigation.NavigateTo("/admin/profile"); return; }
        if (role != "Customer") { Navigation.NavigateTo("/account?returnUrl=%2Fprofile"); return; }

        try { profile = await StoreApi.GetProfileAsync(); }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException or HttpRequestException) { error = ex.Message; }
        loaded = true;
        StateHasChanged();
    }
}

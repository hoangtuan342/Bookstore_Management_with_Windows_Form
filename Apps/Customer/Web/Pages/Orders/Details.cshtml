@page "{id}"
@model TrangSach.Customer.Web.Pages.Orders.DetailsModel
@if (Model.Order is { } order)
{
    <nav class="breadcrumbs"><a asp-page="/Orders/Index">Hóa đơn</a><span>/</span><span>@order.Id</span></nav>
    <div class="section-heading"><div><span class="eyebrow">ĐẶT LÚC @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><h1>Hóa đơn @order.Id</h1></div><span class="status-pill">@TrangSach.Shared.DTO.OrderStatusFormatter.FormatOrderStatus(order.Status)</span></div>
    <div class="checkout-layout">
        <section class="panel">
            <h2>Sản phẩm</h2>
            @foreach (var line in order.Lines)
            {
                <article class="order-product" style="display:flex; align-items:center; gap:16px;">
                    @if (!string.IsNullOrWhiteSpace(line.CoverImagePath))
                    {
                        <img src="@line.CoverImagePath" alt="@line.Title" style="width: 48px; height: 64px; object-fit: cover; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.12);" />
                    }
                    else
                    {
                        <div class="mini-cover" style="width: 48px; height: 64px; font-size:11px;">TS</div>
                    }
                    <div style="flex:1;">
                        <h3><a asp-page="/Books/Details" asp-route-id="@line.BookId" style="color: inherit; text-decoration: none;">@line.Title</a></h3>
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:2px;">
                            <span class="muted">@line.UnitPrice.ToString("N0") ₫ × @line.Quantity</span>
                            @if (line.OriginalPrice > line.UnitPrice)
                            {
                                <span class="muted" style="text-decoration:line-through; font-size:12px;">@(line.OriginalPrice.ToString("N0")) ₫</span>
                                <span class="promo-tag" style="font-size:11px; padding:1px 6px;">🔥 -@(line.DiscountPercent.ToString("0.#"))% @(!string.IsNullOrWhiteSpace(line.PromotionName) ? $"({line.PromotionName})" : "")</span>
                            }
                        </div>
                    </div>
                    <strong>@line.LineTotal.ToString("N0") ₫</strong>
                </article>
            }
        </section>
        <aside class="panel order-summary">
            <h2>Thông tin hóa đơn</h2>
            <p><strong>Người nhận:</strong> @order.ReceiverPhone</p>
            <p><strong>Địa chỉ:</strong> @order.ShippingAddress</p>
            <p><strong>Phương thức:</strong> @TrangSach.Shared.DTO.OrderStatusFormatter.FormatPaymentMethod(order.PaymentMethod)</p>
            <p><strong>Thanh toán:</strong> @TrangSach.Shared.DTO.OrderStatusFormatter.FormatPaymentStatus(order.PaymentStatus)</p>
            
            <div style="margin: 16px 0; padding-top: 12px; border-top: 1px dashed #dbe1d8;">
                <div class="summary-row" style="color: #616b5f;">
                    <span>Tổng tiền hàng (gốc):</span>
                    <span>@((order.TotalAmount + order.DiscountAmount).ToString("N0")) ₫</span>
                </div>
                @if (order.DiscountAmount > 0)
                {
                    <div class="summary-row" style="color: #c62828; font-weight: 600; margin-top: 6px;">
                        <span>Đã giảm trừ khuyến mãi:</span>
                        <span>−@order.DiscountAmount.ToString("N0") ₫</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(order.DiscountDescription))
                    {
                        <div style="font-size: 12px; color: #2e5b3e; background: #eef5ef; padding: 6px 10px; border-radius: 6px; margin-top: 6px; line-height: 1.4;">
                            <strong>🎁 Chi tiết ưu đãi áp dụng:</strong><br />
                            @order.DiscountDescription
                        </div>
                    }
                }
            </div>

            <div class="summary-total"><span>Tổng thanh toán</span><strong>@order.TotalAmount.ToString("N0") ₫</strong></div>
            <a class="button button-light button-wide" asp-page="/Orders/Index">Quay lại danh sách hóa đơn</a>
        </aside>
    </div>
}
@functions { private static string PaymentName(string method) => method switch { "CashOnDelivery" => "Thanh toán khi nhận hàng", "BankTransfer" => "Chuyển khoản", _ => method }; }

@page
@model TrangSach.Customer.Web.Pages.Account.LoginModel
<section class="auth-card"><span class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</span><h1>Đăng nhập</h1><p class="muted">Đăng nhập để quản lý giỏ hàng và theo dõi hóa đơn.</p>
    <form method="post" class="form-stack"><input type="hidden" asp-for="ReturnUrl" /><div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Input.UserNameOrEmail"></label><input asp-for="Input.UserNameOrEmail" autocomplete="username" /><span asp-validation-for="Input.UserNameOrEmail" class="validation"></span>
        <label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="validation"></span>
        <label class="check-row"><input asp-for="Input.RememberMe" /> Ghi nhớ đăng nhập</label><button class="button button-primary button-wide" type="submit">Đăng nhập</button>
    </form><p class="auth-switch">Chưa có tài khoản? <a asp-page="/Account/Register">Đăng ký khách hàng</a></p>
</section>

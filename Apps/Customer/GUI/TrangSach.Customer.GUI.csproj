    <ProjectReference Include="..\..\..\Shared\DTO\TrangSach.Shared.DTO.csproj" />
    <ProjectReference Include="..\..\..\Shared\Security\TrangSach.Shared.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.GUI.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>



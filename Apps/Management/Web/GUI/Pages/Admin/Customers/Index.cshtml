@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Customers.IndexModel
<div class="page-toolbar"><form method="get" class="search-bar"><input name="search" value="@Model.Search" placeholder="Tên, mã khách, điện thoại, email, địa chỉ..."/><button class="button primary">Tìm</button></form><a class="button primary" asp-page="/Admin/Customers/Index">+ Thêm khách hàng</a></div>
<div class="admin-columns"><section class="panel"><div class="panel-head"><h2>Danh sách khách hàng (@Model.Customers.Count)</h2></div><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Khách hàng</th><th>Điện thoại</th><th>Email</th><th>Tài khoản</th><th></th></tr></thead><tbody>@foreach(var c in Model.Customers){<tr><td>@c.Id</td><td><strong>@c.FullName</strong><small class="subcell">@c.Address</small></td><td>@c.PhoneNumber</td><td>@c.Email</td><td>@(c.AccountId is null ? "Chưa có" : c.AccountStatus)</td><td class="actions"><a asp-page="/Admin/Customers/Index" asp-route-id="@c.Id">Sửa</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa khách hàng này?')"><input type="hidden" name="id" value="@c.Id"/><button class="link-danger">Xóa</button></form></td></tr>}</tbody></table></div></section>
<section class="panel edit-panel"><span class="eyebrow">HỒ SƠ KHÁCH HÀNG</span><h2>@(Model.Input.Id is null ? "Thêm khách hàng" : "Cập nhật khách hàng")</h2><form method="post" asp-page-handler="Save" class="form-grid"><input type="hidden" asp-for="Input.Id"/><div asp-validation-summary="ModelOnly" class="validation span-2"></div><label asp-for="Input.FullName"></label><input asp-for="Input.FullName"/><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber"/><label asp-for="Input.Email"></label><input asp-for="Input.Email"/><label asp-for="Input.Address" class="span-2"></label><textarea asp-for="Input.Address" class="span-2" rows="2"></textarea><label asp-for="Input.UserName"></label><input asp-for="Input.UserName"/><label asp-for="Input.Password"></label><input asp-for="Input.Password"/><label asp-for="Input.AccountStatus"></label><select asp-for="Input.AccountStatus"><option>Active</option><option>Inactive</option><option>Locked</option></select><button class="button primary span-2">Lưu khách hàng</button></form></section></div>

@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Suppliers.IndexModel
<div class="admin-columns"><section class="panel"><div class="panel-head"><h2>Nhà cung cấp (@Model.Suppliers.Count)</h2><a class="button light" asp-page="/Admin/Suppliers/Index">+ Thêm</a></div><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Tên nhà cung cấp</th><th>Điện thoại</th><th></th></tr></thead><tbody>@foreach(var s in Model.Suppliers){<tr><td>@s.Id</td><td>@s.Name</td><td>@s.PhoneNumber</td><td class="actions"><a asp-page="/Admin/Suppliers/Index" asp-route-id="@s.Id">Sửa</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa nhà cung cấp này?')"><input type="hidden" name="id" value="@s.Id"/><button class="link-danger">Xóa</button></form></td></tr>}</tbody></table></div></section><section class="panel edit-panel"><span class="eyebrow">ĐỐI TÁC CUNG ỨNG</span><h2>@(Model.Input.Id is null ? "Thêm nhà cung cấp" : "Sửa nhà cung cấp")</h2><form method="post" asp-page-handler="Save" class="form-stack"><input type="hidden" asp-for="Input.Id"/><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Input.Name"></label><input asp-for="Input.Name"/><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber"/><button class="button primary">Lưu nhà cung cấp</button></form></section></div>

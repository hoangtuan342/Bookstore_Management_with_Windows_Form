@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Books.IndexModel
<div class="page-toolbar"><form method="get" class="search-bar"><input name="search" value="@Model.Search" placeholder="Tên sách, tác giả, mã sách, thể loại..." /><button class="button primary" type="submit">Tìm</button><a class="button light" asp-page-handler="Export">Xuất CSV</a><a class="button light" asp-page-handler="ExportExcel">Xuất Excel</a></form><form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="upload-inline"><input type="file" name="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" /><button class="button light" type="submit">Nhập CSV / Excel</button><a asp-page-handler="Template">Tải mẫu Excel</a></form></div>
<details class="panel"><summary>Tìm kiếm nâng cao theo tác giả, thể loại, giá, tồn kho và trạng thái</summary><form method="get" class="form-grid"><label>Từ khóa<input name="search" value="@Model.Search" placeholder="Tên, mã sách hoặc nội dung" /></label><label>Tác giả<input name="authorFilter" value="@Model.AuthorFilter" placeholder="Tên tác giả" /></label><label>Thể loại<select name="categoryFilter"><option value="">Tất cả thể loại</option>@foreach(var category in Model.Categories.Select(x=>x.Name).Distinct().OrderBy(x=>x)){<option value="@category" selected="@(Model.CategoryFilter == category)">@category</option>}</select></label><label>Giá từ<input type="number" min="0" step="1000" name="minPrice" value="@Model.MinPrice" /></label><label>Đến giá<input type="number" min="0" step="1000" name="maxPrice" value="@Model.MaxPrice" /></label><label>Tồn kho từ<input type="number" min="0" name="minStock" value="@Model.MinStock" /></label><label>Đến tồn kho<input type="number" min="0" name="maxStock" value="@Model.MaxStock" /></label><label>Trạng thái<select name="visibility"><option value="">Tất cả</option><option value="active" selected="@(Model.Visibility == "active")">Đang bán</option><option value="hidden" selected="@(Model.Visibility == "hidden")">Đã ẩn</option></select></label><button class="button primary">Áp dụng bộ lọc</button><a class="button light" asp-page="/Admin/Books/Index">Xóa bộ lọc</a></form></details>
<div class="admin-columns"><section class="panel"><div class="panel-head"><div><span class="eyebrow">DANH MỤC</span><h2>Sách (@Model.Books.Count)</h2></div><a class="button primary" asp-page="/Admin/Books/Index">+ Thêm sách</a></div><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>Giá</th><th>Tồn</th><th>Thao tác</th></tr></thead><tbody>@foreach(var book in Model.Books){<tr><td>@book.Id</td><td><strong>@book.Title</strong><small class="subcell">@book.Label</small></td><td>@book.Author</td><td>@book.Category</td><td>@book.Price.ToString("N0") ₫</td><td>@book.AvailableStock</td><td class="actions"><a asp-page="/Admin/Books/Index" asp-route-id="@book.Id">Sửa</a><form method="post" asp-page-handler="Hide" onsubmit="return confirm('Ẩn sách này khỏi cửa hàng?')"><input type="hidden" name="id" value="@book.Id"/><button class="link-danger">Ẩn</button></form></td></tr>}</tbody></table></div></section>
<section class="panel edit-panel"><span class="eyebrow">THÔNG TIN SẢN PHẨM</span><h2>@(string.IsNullOrWhiteSpace(Model.Input.Id) ? "Thêm sách mới" : "Sửa sách")</h2><form method="post" asp-page-handler="Save" class="form-grid"><input type="hidden" asp-for="Input.Id"/><div asp-validation-summary="ModelOnly" class="validation span-2"></div><label asp-for="Input.Title"></label><input asp-for="Input.Title"/><label asp-for="Input.SalePrice"></label><input asp-for="Input.SalePrice" type="number" min="1" step="1000"/><label asp-for="Input.Unit"></label><select asp-for="Input.Unit"><option value="Cuốn">Cuốn</option><option value="Quyển">Quyển</option><option value="Bộ">Bộ</option><option value="Tập">Tập</option></select><label asp-for="Input.CategoryId"></label><select asp-for="Input.CategoryId"><option value="">Chọn thể loại</option>@foreach(var category in Model.Categories){<option value="@category.Id">@category.Name (@category.Id)</option>}</select><label asp-for="Input.PublisherId">Nhà xuất bản</label><select asp-for="Input.PublisherId"><option value="">Không chọn</option>@foreach(var publisher in Model.Publishers){<option value="@publisher.Id">@publisher.Name</option>}</select><label asp-for="Input.AuthorIds">Mã tác giả</label><input asp-for="Input.AuthorIds" placeholder="@string.Join(", ", Model.Authors.Take(5).Select(item => item.Id + "=" + item.Name))"/><label asp-for="Input.Isbn">Mã ISBN</label><input asp-for="Input.Isbn"/><label asp-for="Input.CoverImagePath">Đường dẫn ảnh bìa</label><input asp-for="Input.CoverImagePath"/><label asp-for="Input.Description" class="span-2"></label><textarea asp-for="Input.Description" rows="4" class="span-2"></textarea><label class="check-line span-2"><input asp-for="Input.IsActive"/> Đang bán</label><button class="button primary span-2" type="submit">Lưu sách</button></form></section></div>

@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Vouchers.IndexModel
<section class="panel"><div class="panel-head"><div><span class="eyebrow">MÃ ƯU ĐÃI</span><h2>Voucher (@Model.Vouchers.Count)</h2></div></div><div class="table-wrap"><table><thead><tr><th>Mã voucher</th><th>Chương trình</th><th>Lượt dùng</th><th>Hạn dùng</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>@foreach(var v in Model.Vouchers){<tr><td><strong>@v.Id</strong></td><td>@string.Join(", ",v.Promotions)</td><td>@v.UsageCount / @(v.MaxUsageCount?.ToString() ?? "Không giới hạn") · @v.OrderCount đơn</td><td>@(v.ExpiresAt?.ToString("dd/MM/yyyy") ?? "Không hạn")</td><td><span class="status">@v.Status</span></td><td><details><summary>Chỉnh sửa</summary><form method="post" asp-page-handler="Update" class="form-stack"><input type="hidden" name="id" value="@v.Id"/><label>Trạng thái</label><select name="status"><option selected="@(v.Status == "Active")">Active</option><option selected="@(v.Status == "Inactive")">Inactive</option></select><label>Hạn dùng (yyyy-MM-dd)</label><input name="expiresAt" type="date" value="@v.ExpiresAt?.ToString("yyyy-MM-dd")"/><label>Số lượt tối đa</label><input name="maxUsageCount" type="number" min="1" value="@v.MaxUsageCount"/><button class="button light">Lưu</button></form></details><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa voucher @v.Id?')"><input type="hidden" name="id" value="@v.Id"/><button class="link-danger">Xóa</button></form></td></tr>}</tbody></table></div></section>

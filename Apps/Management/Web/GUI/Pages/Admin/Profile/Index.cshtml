@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Profile.IndexModel
<section class="panel profile-panel"><span class="eyebrow">TÀI KHOẢN NHÂN VIÊN</span><h2>Hồ sơ cá nhân</h2><p class="muted">Thông tin tài khoản đang đăng nhập.</p>
<dl class="profile-details"><dt>Họ và tên</dt><dd>@Model.Profile?.FullName</dd><dt>Tên đăng nhập</dt><dd>@Model.Profile?.UserName</dd><dt>Email</dt><dd>@Model.Profile?.Email</dd><dt>Vai trò</dt><dd>@StaffPermissions.DisplayName(Model.Profile?.Role ?? "")</dd><dt>Số điện thoại</dt><dd>@(string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber) ? "Chưa cập nhật" : Model.Profile.PhoneNumber)</dd><dt>Địa chỉ</dt><dd>@(string.IsNullOrWhiteSpace(Model.Profile?.Address) ? "Chưa cập nhật" : Model.Profile.Address)</dd></dl>
<a class="button primary" asp-page="/Admin/Index">Về tổng quan</a></section>

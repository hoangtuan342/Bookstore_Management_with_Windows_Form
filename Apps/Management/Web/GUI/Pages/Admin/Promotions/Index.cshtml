@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Promotions.IndexModel
<section class="panel create-panel"><div class="panel-head"><div><span class="eyebrow">MARKETING</span><h2>Tạo chương trình mới</h2></div></div><form method="post" asp-page-handler="Create" class="form-grid"><div asp-validation-summary="ModelOnly" class="validation span-2"></div><label asp-for="Input.Name"></label><input asp-for="Input.Name"/><label asp-for="Input.StartsAt"></label><input asp-for="Input.StartsAt" type="date"/><label asp-for="Input.EndsAt"></label><input asp-for="Input.EndsAt" type="date"/><label asp-for="Input.BookId"></label><input asp-for="Input.BookId"/><label asp-for="Input.BookDiscountPercent"></label><input asp-for="Input.BookDiscountPercent" type="number" min="0" max="90" step="0.1"/><label asp-for="Input.MinimumOrderAmount"></label><input asp-for="Input.MinimumOrderAmount" type="number" min="0" step="10000"/><label asp-for="Input.OrderDiscountPercent"></label><input asp-for="Input.OrderDiscountPercent" type="number" min="0" max="90" step="0.1"/><label asp-for="Input.VoucherCode"></label><input asp-for="Input.VoucherCode"/><label asp-for="Input.VoucherDiscountPercent"></label><input asp-for="Input.VoucherDiscountPercent" type="number" min="0" max="90" step="0.1"/><label asp-for="Input.VoucherMaxUses"></label><input asp-for="Input.VoucherMaxUses" type="number" min="1"/><button class="button primary span-2">Tạo chương trình</button></form></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">CHƯƠNG TRÌNH ĐANG QUẢN LÝ</span><h2>Khuyến mãi (@Model.Promotions.Count)</h2></div></div><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Chương trình</th><th>Thời gian</th><th>Ưu đãi hiện có</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model.Promotions){<tr><td>@p.Id</td><td><strong>@p.Name</strong></td><td>@p.StartsAt.ToString("dd/MM/yyyy") – @p.EndsAt.ToString("dd/MM/yyyy")</td><td>@foreach(var offer in p.BookOffers.Concat(p.OrderOffers).Concat(p.Vouchers)){<div>@offer</div>}</td><td><details><summary>Sửa</summary><form method="post" asp-page-handler="Update" class="form-stack"><input type="hidden" name="id" value="@p.Id"/><label>Tên chương trình</label><input name="name" value="@p.Name" required/><label>Bắt đầu</label><input name="startsAt" type="date" value="@p.StartsAt.ToString("yyyy-MM-dd")"/><label>Kết thúc</label><input name="endsAt" type="date" value="@p.EndsAt.ToString("yyyy-MM-dd")"/><button class="button light">Lưu</button></form></details><details><summary>Quy tắc ưu đãi</summary><form method="post" asp-page-handler="Rules" class="form-stack"><input type="hidden" name="id" value="@p.Id"/><label>Sách · mỗi dòng mã sách;phần trăm</label><textarea name="books" rows="3">@string.Join("\n", p.BookRules.Select(x => $"{x.BookId};{x.DiscountPercent.ToString(CultureInfo.InvariantCulture)}"))</textarea><label>Đơn hàng · mỗi dòng mức tối thiểu;phần trăm</label><textarea name="orders" rows="3">@string.Join("\n", p.OrderRules.Select(x => $"{x.MinimumOrderAmount.ToString(CultureInfo.InvariantCulture)};{x.DiscountPercent.ToString(CultureInfo.InvariantCulture)}"))</textarea><label>Voucher · mỗi dòng mã voucher;phần trăm</label><textarea name="vouchers" rows="3">@string.Join("\n", p.VoucherRules.Select(x => $"{x.VoucherId};{x.DiscountPercent.ToString(CultureInfo.InvariantCulture)}"))</textarea><small class="muted">Lưu sẽ thay toàn bộ quy tắc hiện tại của chương trình.</small><button class="button light">Lưu quy tắc</button></form></details><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa chương trình này?')"><input type="hidden" name="id" value="@p.Id"/><button class="link-danger">Xóa</button></form></td></tr>}</tbody></table></div></section>

@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Employees.IndexModel
<div class="page-toolbar"><form method="get" class="search-bar"><input name="search" value="@Model.Search" placeholder="Tên, mã nhân viên, email, vị trí..."/><button class="button primary">Tìm</button></form><a class="button primary" asp-page="/Admin/Employees/Index">+ Thêm nhân viên</a></div>
<div class="admin-columns"><section class="panel"><h2>Danh sách nhân viên (@Model.Employees.Count)</h2><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Nhân viên</th><th>Chức danh</th><th>Lương</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var e in Model.Employees){<tr><td>@e.Id</td><td><strong>@e.LastName @e.FirstName</strong><small class="subcell">@e.Email · @e.UserName</small></td><td>@e.RoleName</td><td>@e.BaseSalary.ToString("N0") ₫</td><td>@e.AccountStatus · @e.LoginStatus</td><td class="actions"><a asp-page="/Admin/Employees/Index" asp-route-id="@e.Id">Sửa</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa nhân viên này?')"><input type="hidden" name="id" value="@e.Id"/><button class="link-danger">Xóa</button></form></td></tr>}</tbody></table></div></section>
<section class="panel edit-panel"><span class="eyebrow">HỒ SƠ NHÂN SỰ</span><h2>@(Model.Input.Id is null ? "Thêm nhân viên" : "Cập nhật nhân viên")</h2><form method="post" asp-page-handler="Save" class="form-grid"><input type="hidden" asp-for="Input.Id"/><div asp-validation-summary="ModelOnly" class="validation span-2"></div><label asp-for="Input.LastName"></label><input asp-for="Input.LastName"/><label asp-for="Input.FirstName"></label><input asp-for="Input.FirstName"/><label asp-for="Input.BirthDate"></label><input asp-for="Input.BirthDate" placeholder="yyyy-MM-dd"/><label asp-for="Input.AvatarPath"></label><input asp-for="Input.AvatarPath"/><label asp-for="Input.BaseSalary"></label><input asp-for="Input.BaseSalary" type="number" min="0" step="100000"/><label asp-for="Input.Address" class="span-2"></label><input asp-for="Input.Address" class="span-2"/><label asp-for="Input.RoleName"></label><select asp-for="Input.RoleName">@foreach(var role in Model.Roles){<option value="@role.Name">@role.Label</option>}</select><label asp-for="Input.AccountStatus"></label><select asp-for="Input.AccountStatus"><option>Active</option><option>Inactive</option><option>Locked</option></select><label asp-for="Input.UserName"></label><input asp-for="Input.UserName"/><label asp-for="Input.Email"></label><input asp-for="Input.Email"/><label asp-for="Input.Password"></label><input asp-for="Input.Password"/><label asp-for="Input.LoginStatus"></label><select asp-for="Input.LoginStatus"><option>Active</option><option>Inactive</option><option>Locked</option></select><button class="button primary span-2">Lưu hồ sơ</button></form></section></div>

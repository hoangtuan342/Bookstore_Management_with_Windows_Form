@page
@model TrangSach.Management.Web.GUI.Pages.Admin.Inventory.IndexModel
<div class="panel create-panel"><div class="panel-head"><div><span class="eyebrow">KHO HÀNG</span><h2>@(Model.Input.Id is null ? "Tạo phiếu nhập" : $"Sửa phiếu {Model.Input.Id}")</h2></div></div>
<form method="post" asp-page-handler="Save" class="form-grid"><input type="hidden" asp-for="Input.Id"/><div asp-validation-summary="ModelOnly" class="validation span-2"></div>
<label asp-for="Input.SupplierId"></label><select asp-for="Input.SupplierId"><option value="">Chọn nhà cung cấp</option>@foreach(var s in Model.Suppliers){<option value="@s.Id">@s.Name · @s.Id</option>}</select>
<label asp-for="Input.EmployeeId"></label><select asp-for="Input.EmployeeId"><option value="">-- Mặc định người đăng nhập --</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.LastName @e.FirstName (@e.Id)</option>}</select>
@for(var i = 0; i < Model.Input.Lines.Count; i++){<div class="form-grid span-2 line-editor"><label>Sách<select asp-for="Input.Lines[i].BookId"><option value="">Chọn sách</option>@foreach(var b in Model.Books){<option value="@b.Id">@b.Title · @b.Id · tồn @b.AvailableStock</option>}</select></label><label>Số lượng<input asp-for="Input.Lines[i].Quantity" type="number" min="1"/></label><label>Giá nhập mỗi cuốn<input asp-for="Input.Lines[i].UnitCost" type="number" min="0.01" step="500"/></label><button class="button light" type="submit" asp-page-handler="RemoveLine" name="index" value="@i">Bỏ dòng</button></div>}
<button class="button light" type="submit" asp-page-handler="AddLine">+ Thêm đầu sách</button><button class="button primary">@(Model.Input.Id is null ? "Ghi nhận nhập kho" : "Lưu phiếu nhập")</button>
</form></div>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">LỊCH SỬ NHẬP</span><h2>Phiếu nhập (@Model.Receipts.Count)</h2></div></div><div class="table-wrap"><table><thead><tr><th>Mã phiếu</th><th>Ngày lập</th><th>Nhà cung cấp</th><th>Nhân viên nhập</th><th>Chi tiết</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var r in Model.Receipts){<tr><td>@r.Id</td><td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@r.SupplierName</td><td>@(string.IsNullOrWhiteSpace(r.EmployeeName) ? (r.EmployeeId ?? "—") : $"{r.EmployeeName} ({r.EmployeeId})")</td><td>@foreach(var line in r.Lines){<div>@line.BookTitle × @line.Quantity <small>(@line.UnitCost.ToString("N0") ₫)</small></div>}</td><td>@r.TotalAmount.ToString("N0") ₫</td><td><span class="status">@r.Status</span></td><td>@if(r.Status == "Posted"){<a asp-page="/Admin/Inventory/Index" asp-route-id="@r.Id">Sửa</a><form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Đảo phiếu nhập @r.Id? Tồn kho sẽ được điều chỉnh.')"><input type="hidden" name="id" value="@r.Id"/><button class="link-danger">Đảo phiếu</button></form>}</td></tr>}</tbody></table></div></section>

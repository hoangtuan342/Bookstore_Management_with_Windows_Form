@page
@model TrangSach.Management.Web.GUI.Pages.Admin.References.IndexModel
<div class="reference-grid">
<section class="panel"><div class="panel-head"><div><span class="eyebrow">PHÂN LOẠI</span><h2>Thể loại (@Model.Categories.Count)</h2></div></div><form method="post" asp-page-handler="Category" class="inline-add"><input name="categoryId" placeholder="Mã thể loại" required maxlength="20"/><input name="name" placeholder="Tên thể loại" required maxlength="120"/><button class="button primary">Thêm</button></form>@foreach(var c in Model.Categories){<details class="reference-row"><summary>@c.Name <small>@c.Id</small></summary><form method="post" asp-page-handler="Category" class="form-grid"><input type="hidden" name="id" value="@c.Id"/><label>Mã</label><input name="categoryId" value="@c.Id"/><label>Tên</label><input name="name" value="@c.Name"/><button class="button light span-2">Lưu</button></form><form method="post" asp-page-handler="DeleteCategory" onsubmit="return confirm('Xóa thể loại này?')"><input type="hidden" name="id" value="@c.Id"/><button class="link-danger">Xóa thể loại</button></form></details>}</section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">TÁC GIẢ</span><h2>Tác giả (@Model.Authors.Count)</h2></div></div><form method="post" asp-page-handler="Author" class="inline-add"><input name="name" placeholder="Tên tác giả" required maxlength="180"/><input name="biography" placeholder="Tiểu sử ngắn"/><button class="button primary">Thêm</button></form>@foreach(var a in Model.Authors){<details class="reference-row"><summary>@a.Name <small>#@a.Id</small></summary><form method="post" asp-page-handler="Author" class="form-stack"><input type="hidden" name="id" value="@a.Id"/><label>Tên tác giả</label><input name="name" value="@a.Name" required/><label>Tiểu sử</label><textarea name="biography" rows="3">@a.Biography</textarea><button class="button light">Lưu</button></form><form method="post" asp-page-handler="DeleteAuthor" onsubmit="return confirm('Xóa tác giả này?')"><input type="hidden" name="id" value="@a.Id"/><button class="link-danger">Xóa tác giả</button></form></details>}</section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">ĐỐI TÁC XUẤT BẢN</span><h2>Nhà xuất bản (@Model.Publishers.Count)</h2></div></div><form method="post" asp-page-handler="Publisher" class="inline-add"><input name="name" placeholder="Tên nhà xuất bản" required maxlength="180"/><input name="address" placeholder="Địa chỉ"/><button class="button primary">Thêm</button></form>@foreach(var p in Model.Publishers){<details class="reference-row"><summary>@p.Name <small>#@p.Id</small></summary><form method="post" asp-page-handler="Publisher" class="form-stack"><input type="hidden" name="id" value="@p.Id"/><label>Tên nhà xuất bản</label><input name="name" value="@p.Name" required/><label>Địa chỉ</label><input name="address" value="@p.Address"/><button class="button light">Lưu</button></form><form method="post" asp-page-handler="DeletePublisher" onsubmit="return confirm('Xóa nhà xuất bản này?')"><input type="hidden" name="id" value="@p.Id"/><button class="link-danger">Xóa nhà xuất bản</button></form></details>}</section>
</div>

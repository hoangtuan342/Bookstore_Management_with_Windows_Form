@page
@using TrangSach.Shared.DTO
@model TrangSach.Management.Web.GUI.Pages.Admin.Orders.IndexModel
<div class="panel create-panel">
    <div class="panel-head"><div><span class="eyebrow">BÁN HÀNG TẠI QUẦY</span><h2>Tạo hóa đơn</h2></div></div>
    <form method="post" asp-page-handler="Create" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="validation span-2"></div>
        <label asp-for="Input.CustomerId"></label><select asp-for="Input.CustomerId"><option value="">Chọn khách hàng</option>@foreach (var customer in Model.Customers){<option value="@customer.Id">@customer.FullName · @customer.Id</option>}</select>
        <label asp-for="Input.ReceiverPhone"></label><input asp-for="Input.ReceiverPhone" />
        <label asp-for="Input.ShippingAddress" class="span-2"></label><input asp-for="Input.ShippingAddress" class="span-2" />
        <label asp-for="Input.PaymentMethod"></label><select asp-for="Input.PaymentMethod"><option value="CashOnDelivery">COD</option><option value="BankTransfer">Chuyển khoản</option></select>
        @for (var i = 0; i < Model.Input.Lines.Count; i++)
        {
            <div class="form-grid span-2 line-editor">
                <label>Sản phẩm<select asp-for="Input.Lines[i].BookId"><option value="">Chọn sách</option>@foreach (var book in Model.Books){<option value="@book.Id">@book.Title · còn @book.AvailableStock</option>}</select></label>
                <label>Số lượng<input asp-for="Input.Lines[i].Quantity" type="number" min="1" max="99" /></label>
                <button class="button light" type="submit" asp-page-handler="RemoveLine" name="index" value="@i">Bỏ dòng</button>
            </div>
        }
        <button class="button light" type="submit" asp-page-handler="AddLine">+ Thêm sách</button>
        <button class="button primary">Tạo hóa đơn</button>
    </form>
</div>
<div class="panel">
    <div class="panel-head"><div><span class="eyebrow">QUẢN LÝ BÁN HÀNG</span><h2>Hóa đơn (@Model.Orders.Count)</h2></div>
        <form method="get" class="search-bar compact"><input name="search" value="@Model.Search" placeholder="Mã hóa đơn, khách, điện thoại..." /><select name="status"><option value="">Mọi trạng thái</option>@foreach(var state in IndexModel.AllowedStatuses){<option value="@state" selected="@(Model.Status == state)">@OrderStatusFormatter.FormatOrderStatus(state)</option>}</select><button class="button primary">Lọc</button></form>
    </div>
    <div class="table-wrap"><table><thead><tr><th>Hóa đơn</th><th>Khách</th><th>Ngày lập</th><th>Trạng thái</th><th>Thanh toán</th><th>Tổng tiền</th><th>Thao tác</th></tr></thead><tbody>
    @foreach(var o in Model.Orders)
    {
        <tr><td><strong>@o.Id</strong><details><summary>@o.ItemCount mặt hàng</summary>@foreach(var line in o.Lines){<small class="subcell">@line.Title × @line.Quantity</small>}</details></td><td>@o.CustomerName<small class="subcell">@o.ReceiverPhone</small></td><td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
            <td><form method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@o.Id" /><select name="orderStatus" class="compact-select">@foreach(var state in IndexModel.AllowedStatuses){<option value="@state" selected="@(o.OrderStatus == state)">@OrderStatusFormatter.FormatOrderStatus(state)</option>}</select><button class="tiny-button">Lưu</button></form></td>
            <td>@OrderStatusFormatter.FormatPaymentStatus(o.PaymentStatus)<br /><small>@OrderStatusFormatter.FormatPaymentMethod(o.PaymentMethod)</small></td><td>@o.TotalAmount.ToString("N0") ₫</td>
            <td class="stack-actions">
                <details><summary>Sửa giao hàng</summary><form method="post" asp-page-handler="Update" class="form-stack"><input type="hidden" name="id" value="@o.Id" /><label>Địa chỉ</label><textarea name="shippingAddress" rows="2">@o.ShippingAddress</textarea><label>Điện thoại</label><input name="receiverPhone" value="@o.ReceiverPhone" /><label>Thanh toán</label><select name="paymentMethod"><option value="CashOnDelivery" selected="@(o.PaymentMethod == "CashOnDelivery")">COD</option><option value="BankTransfer" selected="@(o.PaymentMethod == "BankTransfer")">Chuyển khoản</option></select><button class="tiny-button">Lưu thay đổi</button></form></details>
                @if(o.PaymentMethod == "BankTransfer" && o.PaymentStatus != "Paid"){<form method="post" asp-page-handler="MarkPaid"><input type="hidden" name="id" value="@o.Id" /><button class="tiny-button">Đã thu tiền</button></form>}
                @if(o.OrderStatus == "Cancelled" && o.PaymentStatus == "Paid"){<form method="post" asp-page-handler="Refund"><input type="hidden" name="id" value="@o.Id" /><button class="tiny-button">Đã hoàn tiền</button></form>}
                <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Hủy hóa đơn @o.Id?')"><input type="hidden" name="id" value="@o.Id" /><button class="link-danger">Hủy</button></form>
            </td>
        </tr>
    }
    </tbody></table></div>
</div>

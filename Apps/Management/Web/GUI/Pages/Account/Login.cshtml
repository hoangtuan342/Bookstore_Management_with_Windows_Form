@page
@model TrangSach.Management.Web.GUI.Pages.Account.LoginModel
@if (Model.SessionExpired) { <div class="validation">Phiên API đã hết hạn. Vui lòng đăng nhập lại.</div> }
<section class="login-card"><div class="brand-icon login-mark">TS</div><span class="eyebrow">TRANG SÁCH · QUẢN TRỊ</span><h1>Đăng nhập quản lý</h1><p class="muted">Dùng tài khoản nhân viên để mở đúng khu vực được phân quyền.</p><form method="post" class="form-stack"><input type="hidden" asp-for="ReturnUrl" /><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Input.UserNameOrEmail"></label><input asp-for="Input.UserNameOrEmail" autocomplete="username" /><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="current-password" /><label class="check-line"><input asp-for="Input.RememberMe" /> Ghi nhớ đăng nhập</label><button type="submit" class="button primary full">Đăng nhập</button></form><p class="setup-hint">Nếu database chưa có quản lý đầu tiên, hãy chạy API ở môi trường Development để thiết lập tài khoản ban đầu.</p><a asp-page="/Account/SetupManager">Thiết lập quản lý đầu tiên</a></section>

@using TrangSach.Shared.Security
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Trang Sách quản lý</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-extra.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-charts.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar">
        <a class="admin-brand" asp-page="/Admin/Orders/Index" aria-label="Trang chủ quản lý Trang Sách">
            <span class="brand-icon">TS</span>
            <span>TRANG SÁCH<small>QUẢN LÝ CỬA HÀNG</small></span>
        </a>
        <nav class="side-nav" aria-label="Điều hướng chính">
            <div class="nav-group">
                <span class="nav-group-title">CHỨNG TỪ &amp; TÀI CHÍNH</span>
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "orders"))
                {
                    <a asp-page="/Admin/Orders/Index" aria-current="@(currentPage.StartsWith("/Admin/Orders", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 3h16v18H4zM8 8h8M8 12h8M8 16h5"/></svg></span><span>Hóa đơn</span></a>
                }
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "inventory"))
                {
                    <a asp-page="/Admin/Inventory/Index" aria-current="@(currentPage.StartsWith("/Admin/Inventory", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 8 9-5 9 5v12H3zM3 8l9 5 9-5M12 13v7M7 5l9 5"/></svg></span><span>Phiếu nhập kho</span></a>
                }
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "reports"))
                {
                    <a asp-page="/Admin/Reports/Index" aria-current="@(currentPage.StartsWith("/Admin/Reports", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20h18M5 17V9h4v8M11 17V4h4v13M17 17v-6h4v6"/></svg></span><span>Báo cáo tài chính</span></a>
                }
            </div>
            <div class="nav-group">
                <span class="nav-group-title">HÀNG HÓA &amp; ĐỐI TÁC</span>
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "books"))
                {
                    <a asp-page="/Admin/Books/Index" aria-current="@(currentPage.StartsWith("/Admin/Books", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5z"/><path d="M5 4.5v17M9 6h7M9 10h7"/></svg></span><span>Sách</span></a>
                }
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "inventory"))
                {
                    <a asp-page="/Admin/Suppliers/Index" aria-current="@(currentPage.StartsWith("/Admin/Suppliers", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20V8l9-5 9 5v12zM8 20v-6h8v6M3 9h18"/></svg></span><span>Nhà cung cấp</span></a>
                }
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "customers"))
                {
                    <a asp-page="/Admin/Customers/Index" aria-current="@(currentPage.StartsWith("/Admin/Customers", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 5.5a3.3 3.3 0 0 1 0 6.3M18 15a5 5 0 0 1 3.5 4.8"/></svg></span><span>Khách hàng</span></a>
                }
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "records"))
                {
                    <a asp-page="/Admin/References/Index" aria-current="@(currentPage.StartsWith("/Admin/References", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="8" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="10" cy="19" r="2"/></svg></span><span>Danh mục &amp; tác giả</span></a>
                }
            </div>
            <div class="nav-group">
                <span class="nav-group-title">CHÍNH SÁCH BÁN</span>
                @if (StaffPermissions.CanAccess(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "promotions"))
                {
                    <a asp-page="/Admin/Promotions/Index" aria-current="@(currentPage.StartsWith("/Admin/Promotions", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m20.5 13-7.5 7.5L3 10.5V3h7.5z"/><circle cx="7.5" cy="7.5" r="1.3"/><path d="m10 14 4-4M10 10h.01M14 14h.01"/></svg></span><span>Khuyến mãi</span></a>
                    <a asp-page="/Admin/Vouchers/Index" aria-current="@(currentPage.StartsWith("/Admin/Vouchers", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4zM12 7v2M12 12v2M12 17v1"/></svg></span><span>Voucher</span></a>
                }
            </div>
            <div class="nav-group">
                <span class="nav-group-title">QUẢN TRỊ &amp; GIÁM SÁT</span>
                @if (User.IsInRole(StaffRoles.Manager))
                {
                    <a asp-page="/Admin/Employees/Index" aria-current="@(currentPage.StartsWith("/Admin/Employees", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M17 8h5M19.5 5.5v5"/></svg></span><span>Nhân viên</span></a>
                    <a asp-page="/Admin/Audit/Index" aria-current="@(currentPage.StartsWith("/Admin/Audit", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span><span>Nhật ký hệ thống</span></a>
                }
            </div>
        </nav>
        <section class="sidebar-user" aria-label="Tài khoản">
            <a class="profile-link" asp-page="/Admin/Profile/Index" aria-current="@(currentPage.StartsWith("/Admin/Profile", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                <span class="user-avatar" aria-hidden="true">@((User.Identity.Name ?? "U")[0].ToString().ToUpperInvariant())</span>
                <span class="user-meta"><strong>@User.Identity.Name</strong><small>@StaffPermissions.DisplayName(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")</small></span>
                <svg class="profile-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
            <form method="post" asp-page="/Account/Logout"><button type="submit" class="logout-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></svg>Đăng xuất</button></form>
        </section>
    </aside>
    <div class="main-frame">
        <header class="topbar"><div><span class="eyebrow">TRANG SÁCH · QUẢN LÝ</span><h1>@ViewData["Title"]</h1></div><span class="top-role">@StaffPermissions.DisplayName(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")</span></header>
        <main class="content-area">
            @if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="login-shell">@RenderBody()</main>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
